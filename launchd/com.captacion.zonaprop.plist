<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.captacion.zonaprop</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd /Users/brian/Scraper\ de\ captacion\ inmobiliaria && source venv/bin/activate && python scrapers/scraper_diario.py >> logs/scraper_diario.log 2>&1</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>12</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/brian/Scraper de captacion inmobiliaria/logs/scraper_diario.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/brian/Scraper de captacion inmobiliaria/logs/scraper_diario_error.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
